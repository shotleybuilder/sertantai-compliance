#!/bin/bash
# Development Server Starter for sertantai-compliance
# Starts backend (Phoenix/Ash) and frontend (SvelteKit) in terminal tabs
#
# NOTE: Compliance does NOT own a PostgreSQL instance.
# It shares sertantai-legal's database (port 5436).
# Start legal's postgres first:
#   cd ~/Desktop/sertantai-legal && docker compose -f docker-compose.dev.yml up -d postgres

set -e

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"

BACKEND_DIR="$PROJECT_ROOT/backend"
FRONTEND_DIR="$PROJECT_ROOT/frontend"

BACKEND_PORT="${BACKEND_PORT:-4004}"
FRONTEND_PORT="${FRONTEND_PORT:-5176}"
DB_PORT="${DB_PORT:-5436}"

# ============================================================================
# Terminal emulator detection (Ubuntu=gnome-terminal, Bluefin/Fedora=ptyxis)
# ============================================================================
if command -v gnome-terminal &>/dev/null; then
    TERMINAL_CMD="gnome-terminal"
elif command -v ptyxis &>/dev/null; then
    TERMINAL_CMD="ptyxis"
else
    echo "Error: No supported terminal emulator found (gnome-terminal or ptyxis)"
    exit 1
fi

# Open a new tab with a title, working directory, and command
# Usage: open_tab "title" "working_dir" "command"
open_tab() {
    local title="$1" dir="$2" cmd="$3"
    if [ "$TERMINAL_CMD" = "gnome-terminal" ]; then
        gnome-terminal --tab --title="$title" --working-directory="$dir" -- bash -c "$cmd" &
    else
        # ptyxis -x has quoting issues with complex commands, so use a temp script
        local tmpscript
        tmpscript=$(mktemp /tmp/ptyxis-tab-XXXXXX.sh)
        cat > "$tmpscript" << TABEOF
#!/bin/bash -l
cd "$dir"
$cmd
rm -f "$tmpscript"
TABEOF
        chmod +x "$tmpscript"
        ptyxis --tab -T "$title" -x "$tmpscript" &
    fi
}

echo "Starting sertantai-compliance development servers..."
echo "Project root: $PROJECT_ROOT"
echo ""

# Verify directories exist
if [ ! -f "$BACKEND_DIR/mix.exs" ]; then
    echo "Error: mix.exs not found in $BACKEND_DIR"
    exit 1
fi

if [ ! -f "$FRONTEND_DIR/package.json" ]; then
    echo "Error: package.json not found in $FRONTEND_DIR"
    exit 1
fi

# Check if compliance servers are already running
if pgrep -af "phx.server" | grep -q "sertantai-compliance"; then
    echo "Phoenix backend is already running!"
    echo "Stop it first with: dev-stop"
    exit 1
fi

if pgrep -af "vite.*dev" | grep -q "sertantai-compliance"; then
    echo "SvelteKit frontend is already running!"
    echo "Stop it first with: dev-stop"
    exit 1
fi

# Check shared PostgreSQL (from sertantai-legal) is running
if ! pg_isready -h localhost -p "$DB_PORT" > /dev/null 2>&1; then
    echo "PostgreSQL not available on port $DB_PORT"
    echo ""
    echo "Compliance shares sertantai-legal's database. Start it with:"
    echo "  cd ~/Desktop/sertantai-legal && docker compose -f docker-compose.dev.yml up -d postgres"
    exit 1
fi

echo "Opening terminal tabs..."

BACKEND_CMD="echo 'Starting Phoenix backend on port $BACKEND_PORT...'; echo 'Working directory: '\$(pwd); echo ''; unset DATABASE_URL; mix phx.server; echo ''; echo 'Service stopped. Press Enter to close tab...'; read"
open_tab "compliance-backend" "$BACKEND_DIR" "$BACKEND_CMD"
sleep 0.5

FRONTEND_CMD="echo 'Starting SvelteKit frontend on port $FRONTEND_PORT...'; echo 'Working directory: '\$(pwd); echo ''; npm run dev; echo ''; echo 'Service stopped. Press Enter to close tab...'; read"
open_tab "compliance-frontend" "$FRONTEND_DIR" "$FRONTEND_CMD"

echo ""
echo "Development servers starting in new terminal tabs."
echo ""
echo "URLs:"
echo "  Backend:  http://localhost:$BACKEND_PORT"
echo "  Frontend: http://localhost:$FRONTEND_PORT"
echo "  Tidewave: http://localhost:$BACKEND_PORT/tidewave/mcp"
echo ""
echo "To stop: dev-stop"
